# ==============================================================
# PrepPath Backend Environment Variables (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================

# Database Connection (Neon PostgreSQL)
# Example Neon JDBC URL format:
# jdbc:postgresql://<neon-host>.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Security / JWT Secret (minimum 32 characters)
JWT_SECRET=PrepPathSuperSecretSecureKeyForJwtTokenGeneration2026!

# Allowed Frontend Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Judge0 API (for online code execution in Phase 6)
# If left blank, PrepPath will run in simulated development mode
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here

# AI Buddy API (for Phase 8 interactive tutor)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_ai_key_here
